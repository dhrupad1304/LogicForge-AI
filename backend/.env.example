# Copy the settings you need into backend/.env and restart the backend.

# --- AI model ---------------------------------------------------------------
# ollama     = local model through Ollama (default, free, offline)
# groq       = Groq API free tier        (key: LOGICFORGE_AI_API_KEY)
# gemini     = Google Gemini free tier   (key: LOGICFORGE_AI_API_KEY)
# openrouter = OpenRouter ":free" models (key: LOGICFORGE_AI_API_KEY)
# openai     = any OpenAI-compatible API (also set LOGICFORGE_AI_BASE_URL)
# anthropic  = Claude API (paid; key: ANTHROPIC_API_KEY)
# none       = AI switched off (simulation and schematics still work)
LOGICFORGE_AI_PROVIDER=ollama

# Free cloud providers: key, and optionally a different model / base URL.
LOGICFORGE_AI_API_KEY=
# LOGICFORGE_AI_MODEL=llama-3.3-70b-versatile
# LOGICFORGE_AI_BASE_URL=https://api.groq.com/openai/v1

# Local model (any model you have pulled with `ollama pull ...`).
# On a 16 GB+ Mac, qwen2.5-coder:7b or :14b are noticeably better than :3b.
LOGICFORGE_OLLAMA_MODEL=qwen2.5-coder:3b

# Claude API (used when LOGICFORGE_AI_PROVIDER=anthropic).
# Create a key at https://platform.claude.com and paste it here.
ANTHROPIC_API_KEY=
LOGICFORGE_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (more = more thorough, slower, costlier)
LOGICFORGE_ANTHROPIC_EFFORT=high

# How many design / reference-model attempts Generate may make (default 3).
LOGICFORGE_MAX_ATTEMPTS=3

# --- Legacy OpenAI server (backend/server.js, not used by the frontend) -----
OPENAI_API_KEY=your_openai_api_key_here

# --- Deployment ---------------------------------------------------------------
# Shared password for the site (empty = none, fine on your own machine).
LOGICFORGE_ACCESS_PASSWORD=
# Frontend origins allowed to call this API (comma-separated), e.g. your
# Vercel URL. Optional regex for Vercel preview deployments.
LOGICFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LOGICFORGE_ALLOWED_ORIGIN_REGEX=https://logicforge-[a-z0-9-]+\.vercel\.app
# Per-visitor hourly limits (0 = unlimited).
LOGICFORGE_AI_REQUESTS_PER_HOUR=30
LOGICFORGE_COMPUTE_REQUESTS_PER_HOUR=300
